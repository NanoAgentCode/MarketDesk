<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg">
 <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="行情桌面  ↗" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
 <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A5B6CC" android:textSize="10sp"/>
 <TextView android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center" android:text="↻ 刷新行情" android:textColor="#8AE3CE" android:textSize="14sp"/>
</LinearLayout>
