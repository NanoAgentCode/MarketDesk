<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/quote_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="42dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:orientation="horizontal" android:gravity="center_vertical">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A5B6CC" android:textSize="10sp" android:maxLines="2" android:ellipsize="end"/>
 </LinearLayout>
 <TextView android:id="@+id/price" android:layout_width="90dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFF" android:textSize="12sp"/>
 <TextView android:id="@+id/change" android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="13sp"/>
</LinearLayout>
